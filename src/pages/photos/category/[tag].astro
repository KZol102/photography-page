---
import { getCollection } from "astro:content";
import { toSlug } from "../../../utils/url-utils";
import Layout from "../../../layouts/Layout.astro";
import PhotoGrid from "../../../components/PhotoGrid.astro";

export async function getStaticPaths() {
    const photos = await getCollection("photos");
    const allTags = [...new Set(photos.flatMap((p) => p.data.tags ?? []))];

    return allTags.map((tag: string) => ({
        params: { tag: toSlug(tag) },
        props: {
            photos: photos.filter((p) => p.data.tags?.includes(tag)),
            displayTag: tag,
        },
    }));
}

const { photos } = Astro.props;
---

<Layout title={"Portfolio | " + Astro.props.displayTag}>
    <h1>{Astro.props.displayTag}</h1>

    <PhotoGrid photos={photos.sort((a, b) => b.data.order - a.data.order)} />
</Layout>
