---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    images: { src: ImageMetadata; alt: string; caption?: string }[];
    /** minimum width of one image before the grid wraps to fewer columns */
    minWidth?: string;
}

const { images, minWidth = "250px" } = Astro.props;
---

<div class="image-gallery" style={`--min-col: ${minWidth}`}>
    {
        images.map(({ src, alt, caption }) => (
            <figure>
                <Image
                    src={src}
                    alt={alt}
                    widths={[400, 800]}
                    sizes="(max-width: 600px) 100vw, 50vw"
                />
                {caption && <figcaption>{caption}</figcaption>}
            </figure>
        ))
    }
</div>

<style>
    .image-gallery {
        display: grid;
        grid-template-columns: repeat(
            auto-fit,
            minmax(min(var(--min-col), 100%), 1fr)
        );
        gap: 0.75rem;
        margin-block: 1.5rem;
    }

    figure {
        margin: 0;
    }

    img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 4px;
    }

    figcaption {
        margin-top: 0.35rem;
        font-size: 0.85em;
        opacity: 0.75;
        text-align: center;
    }
</style>
