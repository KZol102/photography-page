---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const photos = await getCollection("photos");
    return photos.map((photo) => ({
        params: { id: photo.id },
        props: { photo },
    }));
}

const { data } = Astro.props.photo;
let lens = data.lens;
if ((data.filters?.length ?? 0) > 0) {
    if (lens) {
        lens += " + ";
    } else {
        lens = "";
    }
    const filters =
        typeof data.filters === "string" ? [data.filters] : data.filters; //TODO: make the yaml file go through parsing / validation
    lens += filters?.join(" + ");
}
let film;
if (!data.film || typeof data.film === "string") {
    film = data.film;
} else {
    film = data.film.name;
    let pushPull;
    if (data.film.push) {
        pushPull = `Pushed +${data.film.push} in development`;
    } else if (data.film.pull) {
        pushPull = `Pulled -${data.film.pull} in development`;
    }
    let rating;
    if (data.film.rating) {
        rating = `rated at ${data.film.rating} ISO`;
    }
    let xProcess;
    if (data.film.cross_process) {
        xProcess = `crossprocessed in ${data.film.cross_process}`;
    }
    film +=
        " (" +
        [data.film.misc, pushPull, rating, xProcess]
            .filter((x) => !!x)
            .join(", ") +
        ")";
}
const details: [string | undefined, string][] = [
    [data.camera, "Camera"],
    [lens, "Lens"],
    [film, "Film"],
];
//TODO: make camera, lens and maybe film clickable, link to filtered photo page
---

<Layout>
    <div class="picture-display content">
        <div class="image-holder">
            <Image
                src={data.image}
                alt={data.title}
                title={data.title}
                width="500"
            />
        </div>
        <div class="details">
            <h1 class="title">{data.title}</h1>
            <p class="details-title">Technical details:</p>
            <div class="technical-details">
                {
                    details
                        .filter(([value]) => !!value)
                        .map(([detail, name]) => (
                            <p class={name.toLowerCase()}>
                                {name}: {detail}
                            </p>
                        ))
                }
            </div>
            {
                data.description && (
                    <div class="description">{data.description}</div>
                )
            }
        </div>
    </div>
</Layout>
