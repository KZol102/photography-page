---
import { getCollection } from "astro:content";
import CategroyDropdown from "../components/CategroyDropdown.astro";
const photos = await getCollection("photos");
const allTags = [...new Set(photos.flatMap((p) => p.data.tags ?? []))];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<title>{Astro.props.title}</title>
	</head>
	<body>
		<div class="page-wrapper">
			<div class="page-container">
				<header>
					<div class="header">
						<div class="logo">Kiss Zoltán Béla</div>
						<ul class="menu">
							<!-- <li class="menu-item"><a href="/">Portfolio</a></li> -->
							<li class="menu-item dropdown">
								<CategroyDropdown tags={allTags} />
							</li>
							<li class="menu-item">
								<a href="/equipment">Equipment</a>
							</li>
							<li class="menu-item">
								<a href="/about">About</a>
							</li>
						</ul>
					</div>
				</header>
				<div class="body"><slot /></div>
			</div>
			<footer>© {new Date().getFullYear()} Kiss Zoltán Béla</footer>
		</div>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: "Inter", sans-serif;
		src: url(fonts/Inter-VariableFont_opsz,wght.ttf);
		font-style: normal;
	}

	/* @media (prefers-color-scheme: dark) { */
	:root {
		background: #1a1a1a;
		color: white;
		--text: white;
		--background: #1a1a1a;
	}
	/* } */

	/* @media (prefers-color-scheme: ligth) {
		:root {
			background: white;
			color: black;
			--text: black;
			--background: white;
		}
	} */

	body {
		max-width: 100vw;
		overflow-x: hidden;
		font-family: "Inter", sans-serif;
	}

	header {
		background-color: var(--background);
		position: sticky;
		top: 0;
		z-index: 9;
	}

	div.page-wrapper {
		position: relative;
		min-height: 100vh;
	}

	div.page-container {
		padding-bottom: 4rem;
	}

	footer {
		position: absolute;
		bottom: 0;
		width: 100%;
		height: 2.5rem;
		text-align: center;
	}

	header div.header {
		display: flex;
		flex-direction: column;
	}

	header div.logo {
		font-weight: bold;
		font-size: 1.5rem;
		margin-top: 0.5rem;
		margin-left: 0.5rem;
		margin-bottom: -0.5rem;
	}

	header div.header ul.menu {
		display: flex;
		flex-direction: row;
		justify-content: space-around;
		align-items: center;
		padding-left: 10%;
		padding-right: 10%;
	}

	header div.header ul.menu a {
		padding: 1rem;
	}

	header div.header ul.menu a,
	header div.header ul.menu a:visited {
		color: var(--text);
		font-weight: bold;
		text-decoration: none;
	}

	header div.header ul.menu > li {
		list-style: none;
	}

	header div.header ul.menu > li:not(.dropdown) {
		padding: 1rem;
	}

	header div.header ul.menu > li:not(.dropdown) a {
		border-radius: 6px;
	}

	header div.header ul.menu li:not(.dropdown):hover a,
	header div.header ul.menu li:not(.dropdown):focus a {
		background-color: var(--text);
		color: var(--background) !important;
	}
</style>
