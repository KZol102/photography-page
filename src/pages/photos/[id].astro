---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { toSlug } from "../../utils/url-utils";

export async function getStaticPaths() {
    const photos = await getCollection("photos");
    return photos.map((photo) => ({
        params: { id: photo.id },
        props: { photo },
    }));
}

const { data } = Astro.props.photo;
let lens = data.lens;
if ((data.filters?.length ?? 0) > 0) {
    if (lens) {
        lens += " + ";
    } else {
        lens = "";
    }
    const filters =
        typeof data.filters === "string" ? [data.filters] : data.filters; //TODO: make the yaml file go through parsing / validation
    lens += filters?.join(" + ");
}
let film;
if (!data.film || typeof data.film === "string") {
    film = data.film;
} else {
    film = data.film.name;
    let pushPull;
    if (data.film.push) {
        pushPull = `Pushed +${data.film.push} in development`;
    } else if (data.film.pull) {
        pushPull = `Pulled -${data.film.pull} in development`;
    }
    let rating;
    if (data.film.rating) {
        rating = `rated at ${data.film.rating} ISO`;
    }
    let xProcess;
    if (data.film.cross_process) {
        xProcess = `crossprocessed in ${data.film.cross_process}`;
    }
    film +=
        " (" +
        [data.film.misc, pushPull, rating, xProcess]
            .filter((x) => !!x)
            .join(", ") +
        ")";
}
const details: [string | undefined, string][] = [
    [data.camera, "Camera"],
    [lens, "Lens"],
    [film, "Film"],
];
//TODO: make camera, lens and maybe film clickable, link to filtered photo page
---

<Layout title={"Portfolio | " + data.title}>
    <div class="picture-display content">
        <div class="image-holder">
            <Image src={data.image} alt={data.title} title={data.title} />
        </div>
        <div class="details">
            <h1 class="title">{data.title}</h1>
            <h2 class="details-title">Technical details:</h2>
            <div class="technical-details">
                {
                    details
                        .filter(([value]) => !!value)
                        .map(([detail, name]) => (
                            <p class={name.toLowerCase() + " detail"}>
                                <span class="detail-name">{name}</span>:{" "}
                                {detail}
                            </p>
                        ))
                }
            </div>
            {
                data.description && (
                    <div class="description">{data.description}</div>
                )
            }
            {
                (data.tags?.length ?? 0) > 0 && (
                    <div class="tags">
                        {(data.tags ?? []).map((tag) => (
                            <a href={"/photos/category/" + toSlug(tag)}>
                                <span class="tag">#{tag}</span>
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</Layout>

<style>
    div.content.picture-display {
        max-width: 100vw;
        width: fit-content;
        margin-left: auto;
        margin-right: auto;
        display: flex;
        flex-direction: column;
        margin-bottom: 4rem;
    }

    div.content.picture-display img {
        max-width: fit-content;
        max-height: 90vh;
        aspect-ratio: 1;
        background: rgb(255, 255, 255);
    }

    div.content.picture-display img {
        max-width: 90vw;
        max-height: 80vh;
        width: auto;
        height: auto;
    }

    div.content.picture-display .details {
        padding-left: 0.7rem;
    }

    div.content.picture-display .details .title {
        font-size: 3.2rem;
    }

    span.detail-name {
        font-weight: 600;
    }

    div.tags {
        padding-top: 2rem;
        display: flex;
        gap: 1rem;
    }
    div.tags span.tag {
        border: 1px solid white;
        padding: 0.5rem;
        border-radius: 1rem;
    }

    div.tags a {
        text-decoration: none;
        color: white;
    }
</style>
